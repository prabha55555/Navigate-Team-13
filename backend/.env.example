# Navigate backend configuration. Copy to .env and fill in real values.
# Never commit a real .env.

# --- Server ---------------------------------------------------------------
PORT=5000
# development | production | test
NODE_ENV=development
# Number of reverse-proxy hops in front of the API (so rate limits see the client IP). Leave empty locally.
TRUST_PROXY=
# debug | info | warn | error | silent (structured JSON logs)
LOG_LEVEL=info

# --- Database -------------------------------------------------------------
# Required in production.
MONGO_URI=mongodb://127.0.0.1:27017/navigate
# Used outside production when MONGO_URI is unreachable.
MONGO_URI_FALLBACK=mongodb://127.0.0.1:27017/navigate
# Database for `npm test` (its name must contain "test"; it is wiped by the tests).
MONGO_URI_TEST=mongodb://127.0.0.1:27017/navigate_test

# --- Auth -----------------------------------------------------------------
# Required in production: random string, at least 32 characters
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Optional; defaults to a value derived from JWT_SECRET.
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret

# --- Web app ----------------------------------------------------------------
# Public URL of the frontend (used in invite and password-reset links).
APP_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Billing ----------------------------------------------------------------
# demo = plan changes apply instantly (default outside production);
# contact-sales = plan changes are recorded as requests (default in production).
BILLING_MODE=demo

# --- Rate limits (optional overrides) ---------------------------------------
# RATE_LIMIT_AUTH_MAX=20       # per 15 min per IP on login/register/forgot/reset
# RATE_LIMIT_GENERAL_MAX=600   # per 15 min per IP on all /api routes
# RATE_LIMIT_AI_MAX=20         # per minute per user on AI endpoints

# --- AI -------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# --- Email (not wired yet: emails are written to the server log) ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="Navigate <no-reply@example.com>"

# --- Legacy (used only by the old /api/assessment routes) ----------------
# ENABLE_MOCK_DATA=false
# HUGGINGFACE_API_KEY=
# OPENAI_API_KEY=
# GPTZERO_API_KEY=
# TURNITIN_API_KEY=
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=
# AWS_REGION=
